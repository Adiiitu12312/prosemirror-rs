{
  "name": "prosemirror-rs-oracle",
  "version": "1.0.0",
  "description": "JavaScript reference oracle and differential fuzzing harness for prosemirror-rs",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:oracle && npm run test:parity-exceptions && npm run fuzz:oracle",
    "oracle": "node oracle/server.js",
    "test:oracle": "node oracle/test_oracle.js",
    "test:parity-exceptions": "node oracle/parity-exceptions.mjs",
    "fuzz:oracle": "node oracle/fuzz_oracle.js",
    "fixtures": "node oracle/generate_fixtures.js"
  },
  "dependencies": {
    "orderedmap": "2.1.1",
    "prosemirror-collab": "1.3.1",
    "prosemirror-commands": "1.7.2",
    "prosemirror-dropcursor": "1.8.4",
    "prosemirror-history": "1.5.2",
    "prosemirror-inputrules": "1.7.0",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.13",
    "prosemirror-schema-basic": "1.2.3",
    "prosemirror-schema-list": "1.4.1",
    "prosemirror-state": "1.4.4",
    "prosemirror-test-builder": "1.1.1",
    "prosemirror-transform": "1.12.7",
    "prosemirror-view": "1.42.9",
    "rope-sequence": "1.3.4",
    "w3c-keyname": "2.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.8.0"
  }
}

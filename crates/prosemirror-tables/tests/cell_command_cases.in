#[test] fn merge_cells_doesnt_do_anything_when_only_one_cell_is_selected() { verify_case(0); }
#[test] fn merge_cells_doesnt_do_anything_when_the_selection_cuts_across_spanning_cells() { verify_case(1); }
#[test] fn merge_cells_can_merge_two_cells_in_a_column() { verify_case(2); }
#[test] fn merge_cells_can_merge_two_cells_in_a_row() { verify_case(3); }
#[test] fn merge_cells_can_merge_a_rectangle_of_cells() { verify_case(4); }
#[test] fn merge_cells_can_merge_already_spanning_cells() { verify_case(5); }
#[test] fn merge_cells_keeps_the_column_width_of_the_first_col() { verify_case(6); }
#[test] fn split_cell_does_nothing_when_cursor_is_inside_of_a_cell_with_attributes_colspan_1_and_rowspan_1() { verify_case(7); }
#[test] fn split_cell_can_split_when_col_spanning_cell_with_cursor() { verify_case(8); }
#[test] fn split_cell_can_split_when_col_spanning_header_cell_with_cursor() { verify_case(9); }
#[test] fn split_cell_does_nothing_for_a_multi_cell_selection() { verify_case(10); }
#[test] fn split_cell_does_nothing_when_the_selected_cell_doesnt_span_anything() { verify_case(11); }
#[test] fn split_cell_can_split_a_col_spanning_cell() { verify_case(12); }
#[test] fn split_cell_can_split_a_row_spanning_cell() { verify_case(13); }
#[test] fn split_cell_can_split_a_rectangular_cell() { verify_case(14); }
#[test] fn split_cell_distributes_column_widths() { verify_case(15); }
#[test] fn split_cell_can_split_a_row_spanning_header_cell_into_a_header_and_normal_cell_() { verify_case(16); }
#[test] fn set_cell_attr_can_set_an_attribute_on_a_parent_cell() { verify_case(17); }
#[test] fn set_cell_attr_does_nothing_when_the_attribute_is_already_there() { verify_case(18); }
#[test] fn set_cell_attr_will_set_attributes_on_all_cells_covered_by_a_cell_selection() { verify_case(19); }
#[test] fn toggle_header_row_turns_a_non_header_row_into_header() { verify_case(20); }
#[test] fn toggle_header_row_turns_a_header_row_into_regular_cells() { verify_case(21); }
#[test] fn toggle_header_row_turns_a_partial_header_row_into_regular_cells() { verify_case(22); }
#[test] fn toggle_header_row_leaves_cell_spans_intact() { verify_case(23); }
#[test] fn toggle_header_column_turns_a_non_header_column_into_header() { verify_case(24); }
#[test] fn toggle_header_column_turns_a_header_column_into_regular_cells() { verify_case(25); }
#[test] fn toggle_header_column_turns_a_partial_header_column_into_regular_cells() { verify_case(26); }
#[test] fn toggle_header_turns_a_header_row_with_colspan_and_rowspan_into_a_regular_cell() { verify_case(27); }
#[test] fn toggle_header_turns_a_header_column_with_colspan_and_rowspan_into_a_regular_cell() { verify_case(28); }
#[test] fn toggle_header_should_keep_first_cell_as_header_when_the_column_header_is_enabled() { verify_case(29); }
#[test] fn toggle_header_turns_a_header_column_into_regular_cells_without_override_header_row() { verify_case(30); }
